<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================== -->
    <!-- 项目基本信息                                -->
    <!-- ========================================== -->
    <groupId>com.authmedemo</groupId>
    <artifactId>AuthMeDemo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AuthMeDemo</name>
    <description>参考AuthMeReloaded实现的Minecraft离线服务器登录插件Demo (1.16.5)</description>

    <!-- ========================================== -->
    <!-- 属性配置：Java版本、编码等                   -->
    <!-- ========================================== -->
    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Spigot 1.16.5 API 版本 -->
        <spigot.version>1.16.5-R0.1-SNAPSHOT</spigot.version>
        <!-- SQLite JDBC 版本 -->
        <sqlite.version>3.36.0.3</sqlite.version>
    </properties>

    <!-- ========================================== -->
    <!-- 仓库配置：Spigot仓库 + Maven中央仓库         -->
    <!-- ========================================== -->
    <repositories>
        <!-- Spigot/Paper API 仓库 -->
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- Paper API 仓库 (可选，兼容Spigot) -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <!-- ========================================== -->
    <!-- 依赖配置                                     -->
    <!-- ========================================== -->
    <dependencies>
        <!-- Spigot API (1.16.5) -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SQLite JDBC 驱动 (用于本地数据库) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- jBCrypt 官方密码哈希库 (与AuthMeReloaded使用的算法一致) -->
        <dependency>
            <groupId>de.svenkubiak</groupId>
            <artifactId>jBCrypt</artifactId>
            <version>0.4.3</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <!-- ========================================== -->
    <!-- 构建配置：打包方式、主清单等                  -->
    <!-- ========================================== -->
    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <!-- 将resources目录下的文件打入jar (plugin.yml, config.yml等) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 编译插件：确保Java 8兼容 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!-- Shade插件：把SQLite JDBC打包进最终jar，避免服务器缺依赖 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 重定位第三方包路径，避免与其他插件冲突 -->
                            <relocations>
                                <relocation>
                                    <pattern>org.sqlite</pattern>
                                    <shadedPattern>com.authmedemo.libs.org.sqlite</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.mindrot</pattern>
                                    <shadedPattern>com.authmedemo.libs.org.mindrot</shadedPattern>
                                </relocation>
                            </relocations>
                            <!-- 过滤不需要的文件 -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
